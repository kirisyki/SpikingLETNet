#!/usr/bin/env python3
"""Build a reproducible statistical analysis of the frozen QIF distortion probe.

This script is deliberately isolated under the probe result directory. It reads
the frozen raw aggregates, recomputes source-balanced and micro statistics, and
writes only derived analysis artifacts next to itself.
"""

from __future__ import annotations

import json
from datetime import datetime, timezone
from pathlib import Path

import nbformat as nbf
import numpy as np
import pandas as pd
from scipy.stats import binomtest, pearsonr, spearmanr


HERE = Path(__file__).resolve().parent
RESULT_DIR = HERE.parent
BOOTSTRAP_REPLICATES = 10_000
BOOTSTRAP_SEED = 20_270_805
CLASS_NAMES = ("background", "facade", "road", "vegetation", "vehicle", "roof")
VARIANT_MODES = ("w4_qif", "a4_input_qif", "w4a4_input_qif")
MODE_LABELS = {
    "fp_qif": "FP-QIF",
    "w4_qif": "W4",
    "a4_input_qif": "A4-input",
    "w4a4_input_qif": "W4A4-input",
}
STAGE_ORDER = (
    "stem",
    "encoder_1",
    "encoder_2",
    "encoder_3",
    "decoder_4",
    "decoder_5",
    "decoder_6",
)
STAGE_LABELS = {
    "stem": "Stem",
    "encoder_1": "Encoder 1",
    "encoder_2": "Encoder 2",
    "encoder_3": "Encoder 3",
    "decoder_4": "Decoder 4",
    "decoder_5": "Decoder 5",
    "decoder_6": "Decoder 6",
}


def stage_for_layer(name: str) -> str:
    if name.startswith("init_conv"):
        return "stem"
    if name.startswith(("downsample_1", "DAB_Block_1", "bn_prelu_2")):
        return "encoder_1"
    if name.startswith(("downsample_2", "DAB_Block_2", "bn_prelu_3")):
        return "encoder_2"
    if name.startswith(("downsample_3", "DAB_Block_3", "bn_prelu_4")):
        return "encoder_3"
    if name.startswith(("DAB_Block_4", "upsample_1", "bn_prelu_5", "LC3")):
        return "decoder_4"
    if name.startswith(("DAB_Block_5", "upsample_2", "bn_prelu_6", "LC2")):
        return "decoder_5"
    if name.startswith(("DAB_Block_6", "upsample_3", "bn_prelu_7", "LC1")):
        return "decoder_6"
    return "other"


def confusion_metrics(matrix: np.ndarray) -> tuple[float, float, np.ndarray]:
    matrix = np.asarray(matrix, dtype=np.float64)
    diagonal = np.diag(matrix)
    union = matrix.sum(axis=0) + matrix.sum(axis=1) - diagonal
    iou = np.divide(
        diagonal,
        union,
        out=np.full_like(diagonal, np.nan),
        where=union != 0,
    )
    miou = float(np.nanmean(iou))
    pixel_accuracy = float(diagonal.sum() / matrix.sum())
    return miou, pixel_accuracy, iou


def percentile_ci(values: np.ndarray) -> tuple[float, float]:
    low, high = np.percentile(values, (2.5, 97.5))
    return float(low), float(high)


def bootstrap_mean(
    values: np.ndarray,
    rng: np.random.Generator,
    replicates: int = BOOTSTRAP_REPLICATES,
) -> tuple[float, float]:
    values = np.asarray(values, dtype=np.float64)
    indices = rng.integers(0, values.size, size=(replicates, values.size))
    return percentile_ci(values[indices].mean(axis=1))


def bootstrap_correlation(
    x: np.ndarray,
    y: np.ndarray,
    method: str,
    rng: np.random.Generator,
    replicates: int = BOOTSTRAP_REPLICATES,
) -> tuple[float, float]:
    x = np.asarray(x, dtype=np.float64)
    y = np.asarray(y, dtype=np.float64)
    indices = rng.integers(0, x.size, size=(replicates, x.size))
    samples: list[float] = []
    function = spearmanr if method == "spearman" else pearsonr
    for sample in indices:
        if np.unique(x[sample]).size < 2 or np.unique(y[sample]).size < 2:
            continue
        samples.append(float(function(x[sample], y[sample]).statistic))
    return percentile_ci(np.asarray(samples, dtype=np.float64))


def bootstrap_class_drops(
    fp: np.ndarray,
    full: np.ndarray,
    rng: np.random.Generator,
    replicates: int = BOOTSTRAP_REPLICATES,
) -> tuple[np.ndarray, np.ndarray]:
    source_count = fp.shape[0]
    samples = rng.integers(0, source_count, size=(replicates, source_count))
    class_drops = np.empty((replicates, len(CLASS_NAMES)), dtype=np.float64)
    miou_drops = np.empty(replicates, dtype=np.float64)
    for index, sample in enumerate(samples):
        fp_miou, _, fp_iou = confusion_metrics(fp[sample].sum(axis=0))
        full_miou, _, full_iou = confusion_metrics(full[sample].sum(axis=0))
        class_drops[index] = fp_iou - full_iou
        miou_drops[index] = fp_miou - full_miou
    return class_drops, miou_drops


def write_csv(frame: pd.DataFrame, name: str) -> None:
    frame.to_csv(HERE / name, index=False, float_format="%.10g")


def rounded_records(frame: pd.DataFrame) -> list[dict[str, object]]:
    clean = frame.copy()
    for column in clean.select_dtypes(include=["float", "float32", "float64"]):
        clean[column] = clean[column].round(10)
    # Pandas float columns preserve NaN through ``where(..., None)``. The
    # JSON round-trip converts missing numeric values to standards-compliant
    # ``null`` while retaining the reviewed row shape.
    return json.loads(clean.to_json(orient="records"))


def build_notebook() -> None:
    notebook = nbf.v4.new_notebook()
    notebook["metadata"] = {
        "kernelspec": {
            "display_name": "Python 3",
            "language": "python",
            "name": "python3",
        },
        "language_info": {"name": "python", "version": "3"},
    }
    notebook["cells"] = [
        nbf.v4.new_markdown_cell(
            "# Integer-LIF quantization distortion: statistical audit\n\n"
            "This notebook reruns the frozen aggregate analysis and exposes the "
            "main audit tables. The statistical unit is the original UDD source "
            "image (35 clusters), not the 8,478 overlapping patches."
        ),
        nbf.v4.new_code_cell(
            "from pathlib import Path\n"
            "import subprocess, sys\n"
            "analysis_dir = Path.cwd()\n"
            "if not (analysis_dir / 'build_analysis.py').exists():\n"
            "    analysis_dir = Path('quantization_distortion_results/full_20260805/statistical_analysis')\n"
            "subprocess.run([sys.executable, str(analysis_dir / 'build_analysis.py'), '--no-notebook'], check=True)"
        ),
        nbf.v4.new_code_cell(
            "import json, pandas as pd\n"
            "summary = json.loads((analysis_dir / 'analysis_summary.json').read_text())\n"
            "pd.DataFrame(summary['representation'])"
        ),
        nbf.v4.new_code_cell(
            "stage = pd.read_csv(analysis_dir / 'stage_statistics.csv')\n"
            "stage.query(\"mode == 'w4a4_input_qif'\")[['stage_label','disagreement','signed_error','zero_delta','saturation_delta','distortion_contribution_share']]"
        ),
        nbf.v4.new_code_cell(
            "layers = pd.read_csv(analysis_dir / 'layer_statistics.csv')\n"
            "layers.sort_values('d_w4a4', ascending=False).head(12)[['layer','stage','d_w4a4','delta_d_full_minus_w4','signed_w4a4','zero_delta_w4a4']]"
        ),
        nbf.v4.new_code_cell(
            "pd.read_csv(analysis_dir / 'correlation_statistics.csv')"
        ),
        nbf.v4.new_markdown_cell(
            "## Interpretation boundary\n\n"
            "These are frozen-checkpoint perturbation statistics. They establish "
            "that the selected checkpoint exhibits observable W4A4 code distortion "
            "and show where it is concentrated. They do not establish that QAD "
            "caused a repair; that requires matched trained QAT/KD/QAD checkpoints."
        ),
    ]
    nbf.write(notebook, HERE / "distortion_statistics.ipynb")


def build_artifact(
    representation: pd.DataFrame,
    stage_stats: pd.DataFrame,
    layer_stats: pd.DataFrame,
    source_stats: pd.DataFrame,
    class_stats: pd.DataFrame,
    correlations: pd.DataFrame,
    findings: dict[str, object],
) -> None:
    generated_at = datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")
    headline = pd.DataFrame(
        [
            {
                "full_disagreement": findings["full_macro_disagreement"],
                "conditional_step": findings["full_conditional_abs_step"],
                "single_step_lower_bound": findings["full_single_step_lower_bound"],
                "miou_drop": findings["full_miou_drop"],
                "rho_flip": findings["rho_disagreement_prediction_flip"],
            }
        ]
    )
    stage_chart = stage_stats[
        [
            "mode_label",
            "stage_label",
            "stage_order",
            "layer_count",
            "disagreement",
            "disagreement_ci_low",
            "disagreement_ci_high",
            "mae",
            "signed_error",
            "zero_delta",
            "saturation_delta",
            "distortion_contribution_share",
        ]
    ].sort_values(["stage_order", "mode_label"])
    full_stage = stage_stats.query("mode == 'w4a4_input_qif'")[
        [
            "stage_label",
            "stage_order",
            "layer_count",
            "disagreement",
            "disagreement_ci_low",
            "disagreement_ci_high",
            "mae",
            "signed_error",
            "zero_reference",
            "zero_variant",
            "zero_delta",
            "saturation_reference",
            "saturation_variant",
            "saturation_delta",
            "distortion_contribution_share",
        ]
    ].sort_values("stage_order")
    top_layers = layer_stats.sort_values("d_w4a4", ascending=False).head(12).copy()
    top_layers["layer_short"] = top_layers["layer"].str.replace(
        "DAB_Block_", "B", regex=False
    ).str.replace("DAB_Module_", "M", regex=False)
    source_scatter = source_stats[
        [
            "source_id",
            "d_w4a4",
            "mae_w4a4",
            "prediction_flip_w4a4",
            "miou_fp",
            "miou_w4a4",
            "miou_drop_w4a4",
            "d_full_minus_w4",
            "d_full_minus_a4",
        ]
    ]
    class_long = class_stats.melt(
        id_vars=["class", "full_drop", "relative_full_drop"],
        value_vars=["iou_fp", "iou_w4", "iou_a4", "iou_w4a4"],
        var_name="mode",
        value_name="iou",
    )
    class_long["mode_label"] = class_long["mode"].map(
        {
            "iou_fp": "FP-QIF",
            "iou_w4": "W4",
            "iou_a4": "A4-input",
            "iou_w4a4": "W4A4-input",
        }
    )

    source = {
        "id": "derived-analysis",
        "label": "Frozen probe derived statistical analysis",
        "path": "quantization_distortion_results/full_20260805/statistical_analysis/analysis_summary.json",
        "query": {
            "description": "Source-balanced aggregation, paired cluster bootstrap, layer/stage decomposition, and source-level correlation computed from the frozen probe counts.",
            "language": "python",
            "query": "Run build_analysis.py with bootstrap unit=source_id, replicates=10000, seed=20270805.",
            "tables_used": [
                "quantization_distortion_results/full_20260805/source_layer_aggregates.json",
                "quantization_distortion_results/full_20260805/source_confusion.json",
                "quantization_distortion_results/full_20260805/per_patch_task_counts.csv.gz",
                "quantization_distortion_results/full_20260805/summary.json",
            ],
            "filters": [
                "UDD6 validation only",
                "35 original source-image clusters",
                "78 active QIF layers",
                "frozen checkpoint; T=1",
            ],
            "metric_definitions": [
                "Code disagreement D_l = count(q_variant != q_reference) / element count.",
                "Source-balanced macro D = equal-weight mean over active layers within source, then equal-weight mean over 35 sources.",
                "Code MAE = sum(abs(q_variant - q_reference)) / element count.",
                "Zero/saturation deltas = variant rate minus FP-QIF reference rate.",
                "All reported uncertainty intervals resample the 35 source-image clusters with replacement.",
            ],
            "executed_at": generated_at,
        },
    }

    title = "W4A4 Integer-LIF 量化失真的统计审计"
    manifest = {
        "version": 1,
        "surface": "report",
        "title": title,
        "description": "Frozen-checkpoint statistical decomposition of QIF code distortion and semantic-segmentation degradation.",
